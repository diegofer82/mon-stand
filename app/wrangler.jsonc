{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nivel superior = desarrollo local (vite dev, tests). Producción vive en "env.production":
  // se elige con CLOUDFLARE_ENV en el build (Vite) y Wrangler despliega la configuración generada.
  // No hay entorno preview (decidido el 2026-09-27): se prueba en local y se despliega a producción.
  "name": "mon-stand-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "ENVIRONMENT": "local",
    "APP_VERSION": "dev",
    // Cada entorno escribe en R2 bajo su prefijo.
    "R2_PREFIX": "local/",
    // Administración (/api/admin): Cloudflare Access (dominio del equipo + AUD de la aplicación) o el secreto
    // ADMIN_TOKEN (wrangler secret put). En local, sin autenticación.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ADMIN_SANS_AUTH": "true",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mon-stand-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "TAUX", "id": "00000000000000000000000000000001" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "mon-stand-local" }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
  },
  "upload_source_maps": true,
  "env": {
    "production": {
      "name": "mon-stand",
      "workers_dev": true,
      // Sin URLs de preview: compartirían la D1 de producción.
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        "APP_VERSION": "2.0.0-alpha",
        "R2_PREFIX": "production/",
        // Rellenar al crear la aplicación Access (Zero Trust → Access → Applications): dominio del equipo
        // (<equipo>.cloudflareaccess.com) y Application Audience (AUD) Tag. Vacíos = solo ADMIN_TOKEN.
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ADMIN_SANS_AUTH": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mon-stand-production",
          "database_id": "c0ece21c-a5c7-4179-b5f2-0f8169b0cc8f",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "TAUX", "id": "e76bf9358d74495c9b55af5110c7ba99" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "mon-stand-files" }],
      // Browser Rendering (incluido en Workers Paid): PDF de clôture. Solo en producción; en local se archiva el HTML.
      "browser": { "binding": "BROWSER" },
      // Cron (en UTC): tasas cada día a las 06:00 de Nouméa (19:00 UTC de la víspera) y archivo del mes
      // anterior cada día 1 a las 20:00 UTC (el 2 a las 07:00 en Nouméa, con el mes ya cerrado).
      "triggers": { "crons": ["0 19 * * *", "0 20 1 * *"] },
    },
  },
}
